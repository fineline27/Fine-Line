# Used at build time via app.config.ts (restart Expo after changing)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy JWT anon key still works:
# SUPABASE_ANON_KEY=

# Alternative names supported by Expo client bundles:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
