# Used at build time via app.config.ts (restart Expo after changing)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy JWT anon key still works:
# SUPABASE_ANON_KEY=

# Alternative names supported by Expo client bundles:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shown on Privacy / Terms for account deletion and privacy requests (required for public launch)
# EXPO_PUBLIC_LEGAL_CONTACT_EMAIL=finelinesport@gmail.com

# Production site origin (no trailing slash) — used for email confirm links
# Production site origin (no trailing slash). Used for auth redirects and link-preview (Open Graph) image URLs.
# EXPO_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Search Console — HTML tag method only (content token from Search Console)
# EXPO_PUBLIC_GOOGLE_SITE_VERIFICATION=your_token_here
# HTML file method: download googleXXXX.html from Search Console into public/ (do not edit).

# When O/U and bonus picks lock (ISO 8601, UTC). Default: first tip 5:30 am ACDT Wed 21 Oct 2026.
# EXPO_PUBLIC_NBA_SEASON_LOCK_ISO=2026-10-20T19:00:00.000Z
